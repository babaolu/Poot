{
  "name": "@poot/shard-engine",
  "version": "0.0.1",
  "description": "CloudMine Shard Engine - C++23 with WASM via Emscripten",
  "main": "dist/shard-engine.js",
  "scripts": {
    "build": "cmake -B build -DCMAKE_TOOLCHAIN_FILE=./emscripten-toolchain.cmake && cmake --build build",
    "build:native": "cmake -B build-native && cmake --build build-native",
    "test": "cd build-native && ctest --output-on-failure",
    "clean": "rm -rf build build-native dist"
  },
  "files": ["dist/*.wasm", "dist/*.js"]
}
