{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "*.wasm", "android/**", "ios/**"]
    },
    "lint": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.js"],
      "outputs": []
    },
    "format": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "prettier.config.js"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
